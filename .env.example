# ──────────────────────────────────────────────────────────────────────────────
# Dhaka Bank emulator environment
#
# Used by:
#   - vite dev/preview servers (server-side proxy forwards /idp/* and /bff/*)
#   - vite build (bakes IDP_URL / BFF_URL into the dev-panel labels)
#
# In production /idp/* and /bff/* are forwarded by the rewrites in vercel.json.
# ──────────────────────────────────────────────────────────────────────────────

# Live IdP (primary). Used by the Vite dev proxy to forward /idp/*.
IDP_URL=https://fi-idp-dhakabank.fly.dev

# Gateway / BFF (rvl-sbqr-fi-gateway), live on Fly.io.
BFF_URL=https://rvl-sbqr-fi-gateway.fly.dev

PORT=5173

# ──────────────────────────────────────────────────────────────────────────────
# Login is the OAuth2 password grant on the IdP's POST /connect/token. The IdP
# stamps iss/aud into the token itself, so the emulator needs no JWT settings.
# When the BFF goes live, change only BFF_URL — no code change required.
# ──────────────────────────────────────────────────────────────────────────────
