# ──────────────────────────────────────────────────────────────────────────────
# Dhaka Bank emulator environment
#
# Used by vite dev/preview servers (server-side proxy) AND baked into the bundle
# at build time via vite.config.ts (define.{ __BFF_TARGET__, __IDP_TARGET__ }).
# ──────────────────────────────────────────────────────────────────────────────

# Live IdP (primary). Used for /idp/* proxy + baked into the bundle.
IDP_URL=https://fi-idp-dhakabank.fly.dev

# Gateway / BFF — NOT YET HOSTED. Placeholder fly.dev app. /bff/* will fail
# at runtime until the real gateway is deployed. Update this once the BFF is up.
BFF_URL=https://fi-bff-dhakabank.fly.dev

PORT=5173

# ──────────────────────────────────────────────────────────────────────────────
# JWT claims — must match what the BFF validates once it is hosted. Right now
# these align with the live Dhaka Bank IdP.
#   iss (issuer)   = full IdP origin (the IdP signs tokens with this)
#   aud (audience) = the resource id the BFF expects to see on incoming tokens
# ──────────────────────────────────────────────────────────────────────────────
VITE_IDP_ISSUER=https://fi-idp-dhakabank.fly.dev
VITE_IDP_AUDIENCE=sbqr-fi-gateway

# ──────────────────────────────────────────────────────────────────────────────
# When the BFF goes live, change only these:
#   BFF_URL          → real gateway URL (e.g. https://bff.dhakabank.dev)
#   VITE_IDP_AUDIENCE → real audience if BFF expects something else
# No code change required — vite.config.ts + vercel.json both read BFF_URL/IDP_URL.
# ──────────────────────────────────────────────────────────────────────────────
