# Where the Vite dev server forwards /bff/* and /idp/* (server-side, not exposed to the browser bundle).
BFF_URL=http://localhost:8080
IDP_URL=http://localhost:5105
PORT=5173

# JWT claims minted by the dev IdP (/mint) at login. Must match the BFF's Auth:Issuer / Auth:Audience.
VITE_IDP_ISSUER=http://localhost:5105
VITE_IDP_AUDIENCE=sbqr-fi-gateway
