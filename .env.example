# ──────────────────────────────────────────────────────────────────────────────
# Dhaka Bank emulator environment
#
# Used by:
#   - vite dev/preview servers (server-side proxy forwards /idp/* and /bff/*)
#   - vite build (bakes IDP_URL / BFF_URL / VITE_PROXY_ORIGIN into the bundle)
#
# In production the SPA talks cross-origin to a SEPARATE Vercel project that
# runs the Node proxy. See proxy-server/README.md.
# ──────────────────────────────────────────────────────────────────────────────

# Live IdP (primary). Used by the Vite dev proxy to forward /idp/*.
IDP_URL=https://fi-idp-dhakabank.fly.dev

# Gateway / BFF — placeholder fly.dev app. The dev proxy returns 502 with a
# clear message until the real gateway is deployed.
BFF_URL=https://fi-bff-dhakabank.fly.dev

# Full origin (scheme + host, no trailing slash) of the proxy project that the
# browser calls in production, e.g. https://emulator-proxy-dhakabank.vercel.app.
# Leave empty in dev — the Vite dev proxy answers same-origin.
VITE_PROXY_ORIGIN=

PORT=5173

# ──────────────────────────────────────────────────────────────────────────────
# JWT claims — must match what the BFF validates once it is hosted. Right now
# these align with the live Dhaka Bank IdP.
#   iss (issuer)   = full IdP origin (the IdP signs tokens with this)
#   aud (audience) = the resource id the BFF expects to see on incoming tokens
# ──────────────────────────────────────────────────────────────────────────────
VITE_IDP_ISSUER=https://fi-idp-dhakabank.fly.dev
VITE_IDP_AUDIENCE=sbqr-fi-gateway

# ──────────────────────────────────────────────────────────────────────────────
# When the BFF goes live, change only these:
#   BFF_URL          → real gateway URL (e.g. https://bff.dhakabank.dev)
#   VITE_IDP_AUDIENCE → real audience if BFF expects something else
# No code change required.
# ──────────────────────────────────────────────────────────────────────────────
